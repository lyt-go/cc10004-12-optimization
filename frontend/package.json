{
  "name": "data-product-ops-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "tsx scripts/local-data-migrate.ts && vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:data": "tsx scripts/local-data-migrate.ts",
    "preview:check": "tsx scripts/preview-check.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
